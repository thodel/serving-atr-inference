# User unit (systemctl --user) — asterAIx has no passwordless sudo / Linger=no.
# Install: scripts/install_user_units.sh  (copies to ~/.config/systemd/user/)
#
# This service SUPERVISES training; it never trains in-process. Each job runs as
# a detached child (start_new_session), so restarting this unit reconciles the
# job records instead of killing a run in progress.
[Unit]
Description=ATR Kraken Training Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Repo/serving-atr-inference/engines
EnvironmentFile=%h/Repo/serving-atr-inference/.env
# GPU 0 is the shared RAG GPU and stays untouched; physical GPU 1 is cuda:0 here.
Environment=CUDA_VISIBLE_DEVICES=1
Environment=PYTHONPATH=%h/Repo/serving-atr-inference/src
# TMPDIR comes from .env (EnvironmentFile) — dill reads it at import time, so a
# shell profile is too late for a systemd service. Same convention as
# lassberg/vlm_training. Do NOT set HF_HOME: ~/.cache/huggingface/hub is a
# symlink to the research share and must stay the effective cache.
ExecStart=%h/Repo/serving-atr-inference/.venvs/kraken-train/bin/python -m uvicorn kraken_train_svc.app:app --host 127.0.0.1 --port 8204
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
