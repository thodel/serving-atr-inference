# Copy to .env on each VM and set the shared key.
# The gateway and the client (agentic_historian) use the SAME value.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ATR_API_KEY=replace-with-a-long-random-shared-secret

# Optional overrides (defaults shown — tuned for asterAIx, see docs/asteraix-environment.md)
# ATR_HOST=0.0.0.0
# ATR_PORT=8200
# ATR_REQUIRE_AUTH=true
# ATR_KRAKEN_URL=http://127.0.0.1:8201
# ATR_TROCR_URL=http://127.0.0.1:8202
# ATR_PARTY_URL=http://127.0.0.1:8203

# ── Where /train/* goes (#137) ──────────────────────────────────────────────
# The gateway forwards /train/* to the training service. Callers (the Discord
# bot, the ATR-MCP) keep talking to :8200 and need no change when this moves.
# Default: a trainer on this box. After the cutover on idhefix: asteraix.
# ATR_TRAIN_URL=http://127.0.0.1:8204
# ATR_TRAIN_URL=http://130.92.59.242:8204
#
# >>> SHARED <<< with asteraix: the trainer's .env must hold the SAME value under
# the same name. asteraix's ufw does not filter high ports, so the trainer
# refuses everything but /health without this key (and without this host in its
# ATR_TRAIN_ALLOWED_CLIENTS). A refusal shows up here as a 502 naming the
# setting, never as a 401 — the caller's key was fine.
# NOT the same value as ATR_API_KEY above (training-atr-models#9): that key
# lets tei in here, this one lets the gateway into the trainer, and one leak
# should not open both. Leave empty for the in-repo trainer on 127.0.0.1.
# Generate one (the trainer insists on >= 32 characters when it listens
# beyond loopback):  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ATR_TRAIN_API_KEY=

# ── Shared model registry (#138) ─────────────────────────────────────────────
# Off unless set. When set, the gateway publishes config/models.yaml (disabled
# entries included) to <root>/models.yaml on startup, and serves the trainer's
# <root>/trained/<id>.yaml next to config/models.local.yaml — reloaded without a
# restart, at most once per ATR_REGISTRY_RELOAD_INTERVAL_S. A share that is not
# mounted is logged, not fatal. The trainer's ATR_TRAIN_MODELS_CONFIG must be
# <root>/models.yaml: the two machines have to agree on this path.
# ATR_REGISTRY_ROOT=/mnt/wbkolleg_dh_1/Textrecognition_Training/registry
# ATR_REGISTRY_RELOAD_INTERVAL_S=5

# HF cache: do NOT set HF_HOME on asterAIx. ~/.cache/huggingface/hub is a symlink
# to /mnt/wbkolleg_dh_1/Textrecognition_Training/hf_hub (the research share), which
# lassberg/vlm_training already populates — sharing it means a dataset either
# project pulled is reused by the other. Setting HF_HOME re-routes downloads onto
# the 100 %-full root partition, which is how they ended up there.
# HF_HOME=

# ── Training service (#34) ──────────────────────────────────────────────────
# asterAIx's root partition filled up (see docs/asteraix-environment.md), so
# training lives on the CIFS research share — the same folder and conventions as
# lassberg/vlm_training. Ground truth is cached ONCE per dataset in the standard
# HF cache above (hub/datasets--<owner>--<name>) and reused by both projects.
ATR_TRAIN_JOBS_ROOT=/mnt/wbkolleg_dh_1/Textrecognition_Training/training_folder/jobs
ATR_TRAIN_TRAINED_ROOT=/mnt/wbkolleg_dh_1/Textrecognition_Training/training_folder/trained
# TMPDIR must be on LOCAL disk, not the share. With it on CIFS, `ketos compile`
# died with OSError [Errno 39] Directory not empty from shutil.rmtree — SMB does
# not release directory entries fast enough for temp-dir churn. (vlm_training's
# README points TMPDIR at the share; that was written when / was full.) The
# trainer refuses to accept a job with a network TMPDIR. dill reads it at IMPORT
# time, so it must be in the environment before python starts — hence here (and
# in the unit), not in a shell profile.
TMPDIR=/home/tobias/atr-cache/tmp
# The disk guard applies to ATR_TRAIN_JOBS_ROOT. The share has TBs free, so the
# 50 GB default is fine there — lower it only if training on the full root disk.
# ATR_TRAIN_MIN_FREE_DISK_GB=50
# ATR_TRAIN_GPU=1
# Streaming is the default (#60): a cached run downloads and converts the whole
# selection before writing a page. Set true only for project-scale selections
# that are re-used across runs — and then keep the datasets cache on LOCAL disk.
# ATR_TRAIN_CACHE_DATASETS=false

# One service (:8204) supervises both training backends, because there is one GPU.
# It imports neither: each job is spawned with its own engine's interpreter, looked
# up under this root (.venvs/kraken-train, .venvs/vlm-train). See docs/VLM_TRAINING.md.
# ATR_TRAIN_VENVS_ROOT=/home/tobias/Repo/serving-atr-inference/.venvs
# VRAM a job must find free before it starts — per engine, because a QLoRA
# fine-tune of an 8B Qwen3-VL wants far more headroom than a kraken run.
# ATR_TRAIN_MIN_FREE_VRAM_MB=12000
# ATR_TRAIN_VLM_MIN_FREE_VRAM_MB=24000
