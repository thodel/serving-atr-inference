# Copy to .env on each VM and set the shared key.
# The gateway and the client (agentic_historian) use the SAME value.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ATR_API_KEY=replace-with-a-long-random-shared-secret

# Optional overrides (defaults shown — tuned for asterAIx, see docs/asteraix-environment.md)
# ATR_HOST=0.0.0.0
# ATR_PORT=8200
# ATR_REQUIRE_AUTH=true
# ATR_KRAKEN_URL=http://127.0.0.1:8201
# ATR_TROCR_URL=http://127.0.0.1:8202
# ATR_PARTY_URL=http://127.0.0.1:8203

# HF cache: do NOT set HF_HOME on asterAIx. ~/.cache/huggingface/hub is a symlink
# to /mnt/wbkolleg_dh_1/Textrecognition_Training/hf_hub (the research share), which
# lassberg/vlm_training already populates — sharing it means a dataset either
# project pulled is reused by the other. Setting HF_HOME re-routes downloads onto
# the 100 %-full root partition, which is how they ended up there.
# HF_HOME=

# ── Training service (#34) ──────────────────────────────────────────────────
# asterAIx's root partition filled up (see docs/asteraix-environment.md), so
# training lives on the CIFS research share — the same folder and conventions as
# lassberg/vlm_training. Ground truth is cached ONCE per dataset in the standard
# HF cache above (hub/datasets--<owner>--<name>) and reused by both projects.
ATR_TRAIN_JOBS_ROOT=/mnt/wbkolleg_dh_1/Textrecognition_Training/training_folder/jobs
ATR_TRAIN_TRAINED_ROOT=/mnt/wbkolleg_dh_1/Textrecognition_Training/training_folder/trained
# dill reads TMPDIR at IMPORT time, so it must be in the environment before python
# starts — hence here (and in the unit), not in a shell profile.
TMPDIR=/mnt/wbkolleg_dh_1/Textrecognition_Training/training_folder/tmp
# The disk guard applies to ATR_TRAIN_JOBS_ROOT. The share has TBs free, so the
# 50 GB default is fine there — lower it only if training on the full root disk.
# ATR_TRAIN_MIN_FREE_DISK_GB=50
# ATR_TRAIN_GPU=1
# ATR_TRAIN_CACHE_DATASETS=true
